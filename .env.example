# Скопируй в файл .env рядом и поменяй значения.
# Локально можно оставить как есть. На хосте с Portainer — обязательно свои.

# Учетка root для Mongo (создается при ПЕРВОМ старте тома mongo-data).
MONGO_ROOT_USER=kisa
MONGO_ROOT_PASS=change-me-please

# На какой адрес биндить порты: локально 127.0.0.1, на хосте за реверс-прокси
# тоже 127.0.0.1 (NPM/Traefik на том же хосте). Наружу — только через прокси.
BIND_ADDR=127.0.0.1
